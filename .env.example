# Environment Configuration for Celestial Digital Portfolio & Showcase

# Secret key for session security (generate a secure random string in production)
SECRET_KEY=celestial-super-secret-key-2026-hackathon

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# To make your database and user accounts 100% PERSISTENT across cold starts in 
# cloud/serverless platforms (like Vercel, Render, or Railway), configure an 
# external PostgreSQL or MySQL database connection URL below.
#
# Free serverless PostgreSQL options (takes 30 seconds to create free DB):
# 1. Neon Serverless Postgres: https://neon.tech
#    DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# 2. Supabase Postgres: https://supabase.com
#    DATABASE_URL=postgresql://postgres:password@db.xyz.supabase.co:5432/postgres
# 3. Railway / Render / Local MySQL:
#    DATABASE_URL=mysql+pymysql://root:password@localhost:3306/celestial_db
#
# If DATABASE_URL is not set:
# - Locally: Defaults to persistent SQLite at instance/database.db
# - On Vercel: Defaults to /tmp/database.db (ephemeral)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://username:password@your-host:5432/your_database
